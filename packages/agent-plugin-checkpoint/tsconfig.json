{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "declaration": true, "declarationMap": true, "stripInternal": true, "sourceMap": true,
    "rootDir": "src", "outDir": "dist", "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "verbatimModuleSyntax": true, "skipLibCheck": true
  }, "include": ["src/**/*.ts"]
}
